# ==============================================================================
# PQ-ZKVote Face Recognition Service — Environment Configuration
# ==============================================================================

# Shared internal HMAC secret between Registrar/Admin and Face Service
INTERNAL_SERVICE_SECRET=pqzkvote_face_service_secret_2026

# AES-256 Fernet key used to encrypt biometric face embeddings at rest
EMBEDDING_ENCRYPTION_KEY=PQZKVOTE_BIOMETRIC_KEY_2026

# Enable dynamic INT8 quantization for FaceNet model (reduces RAM on CPU)
FACENET_QUANTIZE=false

# Directory where encrypted biometric embeddings and temporary data are stored
DATA_DIR=data

# Network host & port configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5000
