{
  "name": "pq-zkvote",
  "version": "0.1.0",
  "description": "PQ-ZKVote — Post-Quantum Zero-Knowledge E-Voting System",
  "scripts": {
    "test:circuits": "mocha test/circuits.test.js --timeout 30000",
    "test:contracts": "npm --prefix contracts test",
    "test:phase3": "mocha test/phase3.test.js --timeout 60000",
    "test:phase7": "mocha test/phase7.test.js --timeout 60000",
    "test:security:contracts": "npm --prefix contracts run test:security",
    "test:security:services": "mocha security/attack_tests/test_service_attacks.js --timeout 60000",
    "test:security:protocol": "./venv/bin/pytest security/attack_tests/test_protocol_attacks.py security/threat_tests/",
    "test:security:fuzz": "./venv/bin/python security/fuzz/fuzz_merkle_proofs.py && ./venv/bin/python security/fuzz/fuzz_public_signals.py && ./venv/bin/python security/fuzz/fuzz_lattice_proofs.py",
    "test:security": "npm run test:security:contracts && npm run test:security:services && npm run test:security:protocol && npm run test:security:fuzz",
    "test:e2e": "(cd contracts && NODE_PATH=node_modules npx hardhat run ../scripts/run_e2e_election.js)",
    "verify:election": "./venv/bin/python verifier/verify_election.py",
    "test:verifier": "./venv/bin/pytest test/test_verifier.py",
    "demo": "./run_demo.sh",
    "start:registrar": "npm --prefix registrar start",
    "start:tally": "npm --prefix tally start",
    "start:anomaly": "./venv/bin/python anomaly/server.py",
    "start:dashboard": "node dashboard/server.js",
    "compile:contracts": "npm --prefix contracts run compile",
    "deploy:contracts": "npm --prefix contracts run deploy",
    "prove": "node scripts/prove_vote.js",
    "verify": "node scripts/verify_vote.js",
    "benchmark": "./venv/bin/python benchmarks/run_benchmarks.py",
    "benchmark:quick": "./venv/bin/python benchmarks/run_benchmarks.py --quick"
  },
  "dependencies": {
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.6",
    "ethers": "^6.10.0",
    "express": "^5.2.1",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.2.0"
  }
}
